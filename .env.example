# The portal can run arbitrary commands, so it is locked behind a password. There
# is nothing to set here: the first time you open the portal in a browser, it asks
# you to choose one (at least 8 characters), and Settings -> Authentication changes it.
# A portal upgraded from a release that kept its password in this file moves it
# into its database on its first start: see docs/guide/upgrading.md.

# Set this to 1 to run with no login at all and no password to choose, which is only
# safe when a reverse proxy with its own login sits in front and nothing else can
# reach the port.
# PORTAL_ALLOW_NO_PASSWORD=1
# Without a login the portal listens on 127.0.0.1 only. Set this to 1 when the
# reverse proxy in front of it is not on this host, such as in another container.
# ALLOW_OPEN=1
# Keeps sessions valid across restarts: openssl rand -hex 32
PORTAL_SECRET=

# The port the portal listens on. The container uses the host's network, so it is
# bound on the host itself.
# PORT=4100

# The time zone of the portal's clock, such as Europe/Berlin. It is UTC unless
# this says otherwise, and the quiet hours of an agent's heartbeat and a repeating
# routine's schedule are read on that clock.
# TZ=Europe/Berlin

# Required: the folder on the host that holds your repositories. It is mounted
# read-write at /workspaces, and there is no default, so the stack will not start
# until you set it.
# WORKSPACES_DIR=/path/to/repos

# Where the portal keeps its data (database, pi settings, sessions). Leave it
# out for a Docker volume, or give an absolute host path to keep it in a folder:
# PORTAL_DATA_DIR=/home/you/.local/share/pithagoras/data
# Keep it apart from WORKSPACES_DIR: that folder is where sessions work, and the
# portal's own database should not sit among the projects.

# host = pi runs inside the portal container (fast, full access to mounted repos)
# container = one isolated container per task (needs the docker socket mount)
EXECUTOR=host

# Overrides only. Leave empty to inherit pi's settings.json.
PI_PROVIDER=
PI_MODEL=
PI_THINKING_LEVEL=

# Container executor only; positive limits are required (zero is rejected).
PI_IMAGE=pithagoras-runner:latest
TASK_MEMORY_MB=2048
TASK_CPUS=2
TASK_PIDS_LIMIT=512
# Provider keys, passed on to pi. For another provider, add its variable to
# environment: in the Compose file, or save the key under Settings -> Providers.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# HTTPS, for notifications, installing as an app and the embedded browser.
# PORTAL_TLS_DIR is mounted at /certs; the two names are files in it.
# PORTAL_TLS_DIR=/etc/pithagoras/certs
# PORTAL_TLS_CERT=/certs/portal.crt
# PORTAL_TLS_KEY=/certs/portal.key

# A local llama.cpp server or llama-swap gateway, if you run one. Reachable from
# inside the container at the same address as on the host, because the container
# shares its network. Behind llama-swap, register it in pi's models.json rather
# than through pi-llama-cpp: see docs/guide/voice.md#behind-llama-swap.
LLAMA_BASE_URL=http://127.0.0.1:8080
# Comma-separated llama.cpp model names whose prompt cache is kept on disk between
# chats. The server needs --parallel 1 and a --slot-save-path, and chats on those
# models then run one at a time: see docs/guide/voice.md#session-prefill-snapshots.
# LLAMA_DISK_CACHE_MODELS=

# The voice service (the Voice extension, Settings -> Extension settings -> Voice
# service) on a host with more than one GPU: the GPU index it uses, as nvidia-smi
# lists them, so the session model keeps the other one. A GPU chosen on its page
# wins over it. Left out, the card with the most free memory is used when engines
# are installed or rebuilt.
# VOICE_GPU=1
# GPU memory in MiB the voice installer keeps free on that card for something
# else, such as a model you run next to it. Counted against every engine choice.
# VOICE_VRAM_RESERVE_MIB=4096

# The Portainer stack (docker-compose.portainer.yml) runs a published image. Set
# this to a release such as 0.2.0 rather than latest, to go back by setting it to
# the one before.
# PITHAGORAS_VERSION=latest

# Upgrading with no room for the backup the database is otherwise given first:
# start once with this set to skip (docs/guide/upgrading.md), then take it out.
# PORTAL_UPGRADE_BACKUP=skip

# How much the server writes to its log and to Settings → Logs. debug adds the
# debug lines (tool calls and approvals so far: name, outcome, duration); info is
# the default. The page keeps the newest 2000 lines and about 2 MB of text; the
# other two change that (docs/guide/settings.md#logs).
# PITHAGORAS_LOG_LEVEL=debug
# PITHAGORAS_LOG_LINES=2000
# PITHAGORAS_LOG_CHARS=2000000

# The agent's browser is the Browser extension, installed from the portal
# (Settings → Extensions, with Docker, which it requires), and the browser itself
# from its page in Settings — it needs almost no configuration in this file. Its
# own web page (ports 3010 and 3011) listens on 127.0.0.1, and the portal's
# /api/x/pithagoras-browser/ui/ is the way in from other machines. To open those
# ports as well (a portal on plain HTTP cannot show that view), set the IPv4
# address they listen on: 0.0.0.0 for every machine that can reach this one,
# anyone with the browser's password included. It is read when the browser is
# installed, so remove the browser and install it again after changing this
# (Remove keeps the profile). See docs/guide/browser.md.
# BROWSER_BIND=0.0.0.0

# Understory, the agent's memory, is the Understory extension, installed from the
# portal (Settings → Extensions, with Docker, which it requires), and set up on its
# page in Settings. In the chat's model mode it reaches the chat's model through a
# server the extension runs on the portal's loopback, at this port; set another
# where 3801 is taken, and the extension makes Understory's container again with
# it as it starts. See docs/guide/features.md#memory-understory.
# UNDERSTORY_LLM_PORT=3801
# How long, in ms, the extension waits on Understory's model before giving up and
# saying so — see docs/reference/configuration.md. Left out, its 30-minute defaults stand.
# UNDERSTORY_LLM_HEADERS_TIMEOUT_MS=1800000
# UNDERSTORY_LLM_BODY_TIMEOUT_MS=1800000
# PORTAL_FETCH_HEADERS_TIMEOUT_MS=1800000
# PORTAL_FETCH_BODY_TIMEOUT_MS=1800000


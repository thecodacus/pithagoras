{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "skipLibCheck": true, "noEmit": true, "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": ["src", "tests", "../../extensions/*/test/browser/*.page.tsx"]
}
